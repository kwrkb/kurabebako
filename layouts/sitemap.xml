{{/* Hugo 0.168.0 の組み込みテンプレート（tpl/tplimpl/embedded/templates/sitemap.xml）の写しに、
     記事が 1 本だけのタグ・カテゴリのページ（_partials/thin_term.html）を飛ばす条件を 1 つ足したもの。
     そのページは noindex にしてあり（extend_head.html）、sitemap に載せると「送信した URL が noindex」になる。
     Hugo の sitemap.disable は front matter でしか指定できず、本数では決められないので、テンプレートごと上書きした。
     build.sh の HUGO_VERSION を上げるときは、組み込み側の変更をここに写す。
     gotmplfmt-ignore-all */ -}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
  xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {{ range where .Pages "Sitemap.Disable" "ne" true }}
    {{- if and .Permalink (not (partial "thin_term.html" .)) -}}
  <url>
    <loc>{{ .Permalink }}</loc>{{ if not .Lastmod.IsZero }}
    <lastmod>{{ safeHTML ( .Lastmod.Format "2006-01-02T15:04:05-07:00" ) }}</lastmod>{{ end }}{{ with .Sitemap.ChangeFreq }}
    <changefreq>{{ . }}</changefreq>{{ end }}{{ if ge .Sitemap.Priority 0.0 }}
    <priority>{{ .Sitemap.Priority }}</priority>{{ end }}{{ if .IsTranslated }}{{ range .AllTranslations }}
    <xhtml:link
                rel="alternate"
                hreflang="{{ .Language.Locale }}"
                href="{{ .Permalink }}"
                />{{ end }}{{ end }}
  </url>
    {{- end -}}
  {{ end }}
</urlset>
